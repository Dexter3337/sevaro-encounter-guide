# Copy to .env.local for local development (`pnpm dev`). .env.local is ignored
# by Git. In production set the same names in Netlify → Site configuration →
# Environment variables. None of these is ever sent to the browser.

# ElevenLabs API key with speech-to-text access (required for live transcription).
ELEVENLABS_API_KEY=

# Realtime Scribe model. Default: scribe_v2_realtime.
# ElevenLabs release notes also list scribe_v2_realtime_turbo and scribe_v2_realtime_lite.
ELEVENLABS_STT_MODEL=scribe_v2_realtime

# Optional. If set, the app asks for this code before issuing a transcription
# token, so a public demo URL cannot spend the account's credits.
STT_ACCESS_CODE=

# AI for transcript drafting and the conversational assistant. Configure one
# provider or both; with both, LLM_PROVIDER goes first and the other is the
# fallback. Set keys with scripts/configure-ai.ps1 / configure-gemini.ps1 so
# they never pass through chat or shell history.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional AI access code. Falls back to STT_ACCESS_CODE when not set.
LLM_ACCESS_CODE=
